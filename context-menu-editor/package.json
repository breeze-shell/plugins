{
  "name": "context-menu-editor",
  "private": true,
  "version": "1.0.0",
  "description": "右键菜单编辑器 - breeze-shell 右键菜单可视化编辑器 (TypeScript + React + Fluent Design)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
